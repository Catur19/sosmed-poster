# Passcode untuk membuka fitur kirim (dicek di server)
APP_PASSCODE=ganti-ini

# Meta (Facebook + Instagram) - pakai Page Access Token (long-lived)
GRAPH_VERSION=v23.0
FB_PAGE_ID=
FB_PAGE_TOKEN=
IG_USER_ID=

# Threads
THREADS_USER_ID=
THREADS_TOKEN=

# X / Twitter (OAuth 1.0a User Context)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Google Sheets (service account, share spreadsheet ke emailnya sebagai Editor)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
SPREADSHEET_ID=
